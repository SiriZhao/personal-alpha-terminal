# Copy to a protected deployment environment file. Never commit real credentials.
PAT_APP_ENV=production
PAT_DATABASE_URL=postgresql+psycopg://pat_app:CHANGE_ME@db.example.internal:5432/personal_alpha
PAT_DATABASE_SSLMODE=verify-full
PAT_DATABASE_POOL_SIZE=5
PAT_DATABASE_MAX_OVERFLOW=10
PAT_DATABASE_POOL_TIMEOUT_SECONDS=30
PAT_DATABASE_POOL_RECYCLE_SECONDS=1800
PAT_DATABASE_STATEMENT_TIMEOUT_MS=120000
PAT_DATABASE_LOCK_TIMEOUT_MS=10000
PAT_DATABASE_APPLICATION_NAME=personal-alpha-terminal
PAT_DATABASE_BACKUP_DIR=D:/PersonalAlphaTerminal/backups/postgresql
PAT_DATABASE_BACKUP_RETENTION_DAYS=30
PAT_DATABASE_PG_DUMP_PATH=C:/Program Files/PostgreSQL/17/bin/pg_dump.exe
PAT_DATABASE_PG_RESTORE_PATH=C:/Program Files/PostgreSQL/17/bin/pg_restore.exe

# Must be a disposable database whose name ends with _restore_test.
PAT_DATABASE_RESTORE_TEST_URL=postgresql+psycopg://pat_restore:CHANGE_ME@db.example.internal:5432/personal_alpha_restore_test

# Local daily research pipeline. Windows Task Scheduler runs in this timezone's local 08:00.
PAT_DAILY_PIPELINE_TIMEZONE=Asia/Shanghai
PAT_DAILY_PIPELINE_MAX_ATTEMPTS=3
PAT_DAILY_PIPELINE_RETRY_BACKOFF_SECONDS=5
PAT_DAILY_PIPELINE_ANALYSIS_LOOKBACK_DAYS=730
PAT_DAILY_PIPELINE_REPORT_PATH=DAILY_PIPELINE_REPORT.md
PAT_DAILY_PIPELINE_QUALITY_REPORT_PATH=DATA_QUALITY_REPORT.md
PAT_DAILY_PIPELINE_LOCK_PATH=var/run/daily_pipeline.lock

# Portfolio management analytical rebalancing thresholds. These never create orders.
PAT_PORTFOLIO_REBALANCE_DRIFT_THRESHOLD=0.05
PAT_PORTFOLIO_MINIMUM_REBALANCE_VALUE=100.0
